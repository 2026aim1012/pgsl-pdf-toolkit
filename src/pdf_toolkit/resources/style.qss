/* PGSL PDF Toolkit — Application Stylesheet */

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    color: #1f2937;
    background-color: #f8fafc;
}

/* ── Panels & Frames ─────────────────────────────────────────────── */

QFrame#sidePanel, QWidget#sidePanel {
    background-color: #ffffff;
    border-right: 1px solid #e2e8f0;
}

QFrame#previewContainer, QWidget#previewContainer {
    background-color: #f8fafc;
}

QFrame#toolkitContainer, QWidget#toolkitContainer {
    background-color: #ffffff;
    border-left: 1px solid #e2e8f0;
}

/* Section titles */
QLabel#sectionTitle, QLabel#toolkitTitle {
    font-size: 12px;
    font-weight: 700;
    color: #475569;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 2px 0;
}

/* Subtitles, hints, elided paths */
QLabel#pathLabel {
    font-size: 11px;
    color: #64748b;
    padding: 2px 0;
}

QLabel#hint {
    font-size: 11px;
    color: #64748b;
    padding: 4px 0;
}

/* ── Push Buttons ─────────────────────────────────────────────────── */

QPushButton {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 7px 14px;
    font-weight: 500;
    color: #1f2937;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #f1f5f9;
    border-color: #94a3b8;
}

QPushButton:pressed {
    background-color: #e2e8f0;
}

QPushButton:disabled {
    background-color: #f8fafc;
    border-color: #e2e8f0;
    color: #94a3b8;
}

QPushButton:focus {
    border: 2px solid #2563eb;
    outline: none;
}

/* Specific buttons */
QPushButton#openFolder {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    font-weight: 600;
    padding: 8px 16px;
}

QPushButton#openFolder:hover {
    background-color: #f8fafc;
    border-color: #3b82f6;
    color: #1d4ed8;
}

QPushButton#navButton {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 15px;
    font-weight: bold;
    min-width: 32px;
    min-height: 28px;
    padding: 2px 8px;
}

QPushButton#navButton:hover {
    background-color: #eff6ff;
    border-color: #3b82f6;
    color: #1d4ed8;
}

QPushButton#primaryButton, QPushButton#compressButton {
    background-color: #2563eb;
    color: #ffffff;
    font-weight: 600;
    border: 1px solid #1d4ed8;
    border-radius: 6px;
    padding: 8px 16px;
}

QPushButton#primaryButton:hover, QPushButton#compressButton:hover {
    background-color: #1d4ed8;
}

QPushButton#primaryButton:pressed, QPushButton#compressButton:pressed {
    background-color: #1e40af;
}

QPushButton#cancelButton {
    background-color: #ffffff;
    border: 1px solid #fca5a5;
    border-radius: 4px;
    color: #dc2626;
    font-weight: 600;
    font-size: 11px;
    padding: 3px 12px;
    min-height: 16px;
}

QPushButton#cancelButton:hover {
    background-color: #fef2f2;
    border-color: #ef4444;
    color: #b91c1c;
}

QPushButton#cancelButton:pressed {
    background-color: #fee2e2;
}

/* ── Lists & Trees ────────────────────────────────────────────────── */

QListWidget {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}

QListWidget#explorer {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
}

QListWidget#explorer::item {
    padding: 6px 8px;
    border-radius: 4px;
    margin: 1px 0;
}

QListWidget#explorer::item:hover {
    background-color: #f1f5f9;
}

QListWidget#explorer::item:selected {
    background-color: #dbeafe;
    color: #1e40af;
    border: 1px solid #bfdbfe;
}

/* ── Preview Area ─────────────────────────────────────────────────── */

QLabel#pageView {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
}

QFrame#thumbStrip {
    border: 1px dashed #cbd5e1;
    border-radius: 8px;
    background-color: #f8fafc;
    padding: 4px;
}

QListWidget#thumbs {
    background-color: transparent;
    border: none;
    outline: none;
}

QListWidget#thumbs::item {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
    margin: 2px;
    padding: 2px;
}

QListWidget#thumbs::item:hover {
    border-color: #93c5fd;
    background-color: #f0f7ff;
}

QListWidget#thumbs::item:selected {
    border: 2px solid #2563eb;
    background-color: #eff6ff;
    color: #1e40af;
}

/* ── Inputs, Combos & SpinBoxes ──────────────────────────────────── */

QLineEdit, QSpinBox, QComboBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 5px 8px;
    color: #1f2937;
    min-height: 20px;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 2px solid #2563eb;
    outline: none;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QGroupBox {
    font-weight: 600;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 12px;
    background-color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #374151;
    font-size: 11px;
}

/* ── Scrollbars ───────────────────────────────────────────────────── */

QScrollBar:vertical {
    border: none;
    background-color: #f1f5f9;
    width: 10px;
    margin: 0;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #cbd5e1;
    min-height: 24px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94a3b8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    border: none;
    background-color: #f1f5f9;
    height: 10px;
    margin: 0;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #cbd5e1;
    min-width: 24px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #94a3b8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Splitter ─────────────────────────────────────────────────────── */

QSplitter::handle {
    background-color: #e2e8f0;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:hover {
    background-color: #3b82f6;
    width: 3px;
}

/* ── Status Bar ───────────────────────────────────────────────────── */

QStatusBar, QWidget#statusBarWidget {
    background-color: #ffffff;
    border-top: 1px solid #e2e8f0;
    min-height: 36px;
}

QLabel#fileInfoLabel {
    font-size: 12px;
    font-weight: 600;
    color: #1f2937;
    padding-left: 8px;
}

QLabel#statusMessageLabel {
    font-size: 12px;
    color: #4b5563;
    padding-left: 8px;
}

QLabel#percentLabel {
    font-size: 12px;
    font-weight: 600;
    color: #2563eb;
    min-width: 40px;
    text-align: right;
}

QProgressBar#statusBarProgress {
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    text-align: center;
    background-color: #e2e8f0;
    height: 12px;
    max-height: 12px;
}

QProgressBar#statusBarProgress::chunk {
    background-color: #2563eb;
    border-radius: 4px;
}

/* ── Menu Bar ─────────────────────────────────────────────────────── */

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #f1f5f9;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #eff6ff;
    color: #1d4ed8;
}

QMenu::separator {
    height: 1px;
    background-color: #e2e8f0;
    margin: 4px 0;
}
